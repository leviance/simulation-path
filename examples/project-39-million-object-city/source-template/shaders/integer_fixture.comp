#version 430 core

#ifndef LAB_CHECKPOINT
#define LAB_CHECKPOINT 12
#endif

layout(local_size_x = 256) in;

#if LAB_CHECKPOINT >= 11
struct Stats {
    uvec4 counts;
    float minimumDistance;
    float maximumDistance;
    uint tested;
    uint padding;
    uvec4 integerStats;
};

layout(std430, binding = 0) readonly buffer Input { uint values[]; };
layout(std430, binding = 1) writeonly buffer Output { Stats outputStats[]; };
uniform uint uCount;
shared uvec4 temporary[256];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint index = gl_GlobalInvocationID.x;
    temporary[lane] = uvec4(0u, 0xffffffffu, 0u, 0u);
    if (index < uCount) {
        uint value = values[index];
        temporary[lane] = uvec4(value, value, value, 1u);
    }
    memoryBarrierShared();
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            uvec4 other = temporary[lane + stride];
            temporary[lane].x += other.x;
            temporary[lane].y = min(temporary[lane].y, other.y);
            temporary[lane].z = max(temporary[lane].z, other.z);
            temporary[lane].w += other.w;
        }
        memoryBarrierShared();
        barrier();
    }
    if (lane == 0u) {
        float infinity = uintBitsToFloat(0x7f800000u);
        outputStats[gl_WorkGroupID.x] = Stats(uvec4(0u), infinity, -infinity, 0u, 0u, temporary[0]);
    }
}
#else
void main() {
}
#endif
