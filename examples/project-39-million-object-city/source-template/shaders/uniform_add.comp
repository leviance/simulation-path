#version 430 core

#ifndef LAB_CHECKPOINT
#define LAB_CHECKPOINT 12
#endif

layout(local_size_x = 256) in;

#if LAB_CHECKPOINT >= 7
layout(std430, binding = 0) buffer Prefix { uvec4 prefixes[]; };
layout(std430, binding = 1) readonly buffer Offsets { uvec4 blockOffsets[]; };
uniform uint uCount;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uCount) {
        return;
    }
    // Global order comes from scanned block totals, never from atomic arrival order.
    prefixes[index] += blockOffsets[index / 512u];
}
#else
void main() {
}
#endif
