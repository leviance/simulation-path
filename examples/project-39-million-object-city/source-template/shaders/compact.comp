#version 430 core

#ifndef LAB_CHECKPOINT
#define LAB_CHECKPOINT 12
#endif

layout(local_size_x = 256) in;

#if LAB_CHECKPOINT >= 8
layout(std430, binding = 0) readonly buffer Masks { uvec4 masks[]; };
layout(std430, binding = 1) readonly buffer Prefix { uvec4 prefixes[]; };
layout(std430, binding = 2) readonly buffer Stats { uvec4 counts; };
layout(std430, binding = 3) writeonly buffer Visible { uint visibleIDs[]; };
uniform uint uCount;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uCount || masks[index].w == 0u) {
        return;
    }
    uint group = 0u;
    uint groupBase = 0u;
    if (masks[index].y != 0u) {
        group = 1u;
        groupBase = counts.x;
    }
    if (masks[index].z != 0u) {
        group = 2u;
        groupBase = counts.x + counts.y;
    }
    uint destination = groupBase + prefixes[index][group];
    visibleIDs[destination] = index;
}
#else
void main() {
}
#endif
