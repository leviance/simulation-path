#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) buffer Cursors { uint cursors[]; };
layout(std430,binding=2) writeonly buffer Indices { uint indices[]; };
void main() {
    // Each particle ID is stored exactly once, without fixed cell capacities.
    uint i=gl_GlobalInvocationID.x;
    if (i>=uCount || bad(positions[i].xyz)) return;
    uint slot=atomicAdd(cursors[flatten(cellOf(positions[i].xyz))],1u);
    indices[slot]=i;
}
