#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) readonly buffer Velocities { vec4 velocities[]; };
layout(std430,binding=2) readonly buffer Acceleration { vec4 acceleration[]; };
layout(std430,binding=3) writeonly buffer NextPositions { vec4 nextPositions[]; };
layout(std430,binding=4) writeonly buffer NextVelocities { vec4 nextVelocities[]; };
layout(std430,binding=5) readonly buffer Stats { vec4 stats[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uCount) return;
    float dt=0.0005;
#if LAB_CHECKPOINT >= 9
    dt=min(dt,min(0.25*uH/(uC+stats[0].x),0.25*sqrt(uH/max(stats[0].y,1e-12))));
    if(stats[0].w>0.0 || dt<1e-6) { nextPositions[i]=positions[i]; nextVelocities[i]=velocities[i]; return; }
#endif
    vec3 velocity=velocities[i].xyz+dt*acceleration[i].xyz;
    vec3 position=positions[i].xyz+dt*velocity;
    for(int axis=0;axis<3;axis++) {
        float radius=uSpacing/2.0;
        if(position[axis]<radius) { position[axis]=radius; if(velocity[axis]<0.0) velocity[axis]*=-0.1; }
        if(position[axis]>1.0-radius) { position[axis]=1.0-radius; if(velocity[axis]>0.0) velocity[axis]*=-0.1; }
    }
    nextPositions[i]=vec4(position,1.0);
    nextVelocities[i]=vec4(velocity,0.0);
}
