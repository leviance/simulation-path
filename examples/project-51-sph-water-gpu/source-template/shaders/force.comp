#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) readonly buffer Velocities { vec4 velocities[]; };
layout(std430,binding=2) readonly buffer Density { vec4 density[]; };
layout(std430,binding=3) writeonly buffer Acceleration { vec4 acceleration[]; };
layout(std430,binding=4) readonly buffer Counts { uint counts[]; };
layout(std430,binding=5) readonly buffer Offsets { uint offsets[]; };
layout(std430,binding=6) readonly buffer Indices { uint indices[]; };
#if LAB_CHECKPOINT >= 6
vec3 pairAcceleration(uint i,uint j) {
    if (i==j) return vec3(0.0);
    vec3 d=positions[i].xyz-positions[j].xyz;
    float rhoA=density[i].x,rhoB=density[j].x;
    float coefficient=density[i].y/(rhoA*rhoA)+density[j].y/(rhoB*rhoB);
    coefficient+=viscosity(d,velocities[i].xyz-velocities[j].xyz,rhoA,rhoB);
    return -uMass*coefficient*gradient(d);
}
#endif
void main() {
#if LAB_CHECKPOINT >= 6
    uint i=gl_GlobalInvocationID.x;
    if (i>=uCount) return;
    if (density[i].w>0.0 || bad(velocities[i].xyz)) { acceleration[i]=vec4(0.0,0.0,0.0,1.0); return; }
    vec3 a=vec3(0.0);
#if LAB_CHECKPOINT >= 7
    a.y=-uGravity;
#endif
    uint visited=0u;
#if LAB_CHECKPOINT >= 8
    if (uGrid!=0) {
        ivec3 center=cellOf(positions[i].xyz);
        for (int z=-1;z<=1;z++) for (int y=-1;y<=1;y++) for (int x=-1;x<=1;x++) {
            ivec3 c=center+ivec3(x,y,z);
            if (!validCell(c)) continue;
            uint cell=flatten(c),end=offsets[cell]+counts[cell];
            for (uint slot=offsets[cell];slot<end;slot++) {
                if (++visited>4096u) { acceleration[i]=vec4(0.0,0.0,0.0,1.0); return; }
                a+=pairAcceleration(i,indices[slot]);
            }
        }
    } else
#endif
    {
        for (uint j=0u;j<uCount;j++) a+=pairAcceleration(i,j);
    }
    float error=0.0;
    if (bad(a)) { a=vec3(0.0); error=1.0; }
    acceleration[i]=vec4(a,error);
#endif
}
