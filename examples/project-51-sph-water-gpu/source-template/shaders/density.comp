#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) writeonly buffer Density { vec4 density[]; };
layout(std430,binding=2) readonly buffer Counts { uint counts[]; };
layout(std430,binding=3) readonly buffer Offsets { uint offsets[]; };
layout(std430,binding=4) readonly buffer Indices { uint indices[]; };
void main() {
#if LAB_CHECKPOINT >= 5
    uint i=gl_GlobalInvocationID.x;
    if (i>=uCount) return;
    vec3 p=positions[i].xyz;
    float rho=0.0;
    uint visited=0u;
    if (bad(p)) { density[i]=vec4(1000.0,0.0,0.0,1.0); return; }
#if LAB_CHECKPOINT >= 8
    if (uGrid!=0) {
        ivec3 center=cellOf(p);
        for (int z=-1;z<=1;z++) for (int y=-1;y<=1;y++) for (int x=-1;x<=1;x++) {
            ivec3 c=center+ivec3(x,y,z);
            if (!validCell(c)) continue;
            uint cell=flatten(c),end=offsets[cell]+counts[cell];
            for (uint slot=offsets[cell];slot<end;slot++) {
                if (++visited>4096u) { density[i]=vec4(1000.0,0.0,0.0,1.0); return; }
                rho+=uMass*kernel(length(p-positions[indices[slot]].xyz));
            }
        }
    } else
#endif
    {
        for (uint j=0u;j<uCount;j++) rho+=uMass*kernel(length(p-positions[j].xyz));
    }
    float pressure=0.0;
#if LAB_CHECKPOINT >= 6
    pressure=max(0.0,uC*uC*(rho-1000.0));
#endif
    float error=0.0;
    if (isnan(rho) || isinf(rho) || rho<=0.0 || isnan(pressure) || isinf(pressure)) error=1.0;
    density[i]=vec4(rho,pressure,0.0,error);
#endif
}
