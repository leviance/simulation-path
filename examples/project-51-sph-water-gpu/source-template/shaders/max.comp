#version 430 core
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Input { vec4 inputValues[]; };
layout(std430,binding=1) writeonly buffer Output { vec4 outputValues[]; };
uniform uint uCount;
shared vec4 partial[256];
void main() {
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x;
    partial[lane]=vec4(0.0);
    if(i<uCount) partial[lane]=inputValues[i];
    barrier();
    for(uint stride=128u;stride>0u;stride/=2u) {
        if(lane<stride) partial[lane]=max(partial[lane],partial[lane+stride]);
        barrier();
    }
    if(lane==0u) outputValues[gl_WorkGroupID.x]=partial[0];
}
