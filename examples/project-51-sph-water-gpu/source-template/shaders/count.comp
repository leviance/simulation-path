#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) buffer Counts { uint counts[]; };
void main() {
    // Atomic count reserves no particle slot yet.
    uint i=gl_GlobalInvocationID.x;
    if (i>=uCount || bad(positions[i].xyz)) return;
    atomicAdd(counts[flatten(cellOf(positions[i].xyz))],1u);
}
