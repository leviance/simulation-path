#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) writeonly buffer Positions { vec4 positions[]; };
layout(std430,binding=1) writeonly buffer Velocities { vec4 velocities[]; };
layout(std430,binding=2) writeonly buffer Density { vec4 density[]; };
layout(std430,binding=3) writeonly buffer Acceleration { vec4 acceleration[]; };
void main() {
    // GPU creates exactly uCount particles; no million-element CPU upload.
    uint i=gl_GlobalInvocationID.x;
    if (i>=uCount) return;
    uvec3 cell=uvec3(i%uSide,(i/uSide)%uSide,i/(uSide*uSide));
    positions[i]=vec4(vec3(0.08,0.12,0.3)+(vec3(cell)+0.5)*uSpacing,1.0);
    velocities[i]=vec4(0.0);
    density[i]=vec4(1000.0,0.0,0.0,0.0);
    acceleration[i]=vec4(0.0);
}
