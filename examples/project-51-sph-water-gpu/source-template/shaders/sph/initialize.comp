#if LAB_CHECKPOINT >= 3
#version 430 core
layout(local_size_x = 128) in;

layout(std430, binding = 0) writeonly buffer Positions {
    vec4 position[];
};

layout(std430, binding = 1) writeonly buffer Velocities {
    vec4 velocity[];
};

layout(std430, binding = 2) writeonly buffer Fields {
    vec2 field[];
};

uniform uint particleCount;
uniform int latticeSide;
uniform int preset;
uniform float spacing;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount)
        return;
    int nx = latticeSide, ny = latticeSide;
    vec3 origin = vec3(0, 0, .275);
    if (preset == 1) {
        nx = 2 * latticeSide;
        ny = latticeSide / 4;
        origin = vec3(.275, 0, 0);
    }
    // [snippet initialize]
    int x = int(i) % nx;
    int y = (int(i) / nx) % ny;
    int z = int(i) / (nx * ny);
    position[i] = vec4(origin + (vec3(x, y, z) + .5) * spacing, 1.0);
    velocity[i] = vec4(0.0);
    field[i] = vec2(1000.0, 0.0);
    // [/snippet initialize]
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
