#if LAB_CHECKPOINT >= 4
#version 430 core
layout(local_size_x = 128) in;
#include "shared/meta.glsl"
#include "shared/physics.glsl"

layout(std430, binding = 0) readonly buffer Positions {
    vec4 position[];
};

layout(std430, binding = 2) writeonly buffer Fields {
    vec2 field[];
};

layout(std430, binding = 5) readonly buffer Offsets {
    uint offsets[];
};

layout(std430, binding = 6) readonly buffer Indices {
    uint indices[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount || flags != 0u)
        return;
    vec3 point = position[i].xyz;
    float density = 0.0;
    uint visited = 0u;
    if (useGrid) {
        ivec3 centre = ivec3(floor(point / (2.0 * smoothingLength)));
        // [snippet density-grid]
        for (int z = -1; z <= 1; z++)
            for (int y = -1; y <= 1; y++)
                for (int x = -1; x <= 1; x++) {
                    ivec3 cell = centre + ivec3(x, y, z);
                    if (!validCell(cell))
                        continue;
                    uint id = cellId(cell);
                    for (uint k = offsets[id]; k < offsets[id + 1u]; k++) {
                        visited++;
                        if (visited > 1024u) {
                            atomicOr(flags, 4u);
                            return;
                        }
                        uint j = indices[k];
                        density += particleMass * kernel3(length(point - position[j].xyz));
                    }
                }
        // [/snippet density-grid]
    } else {
        if (particleCount > 512u) {
            atomicOr(flags, 8u);
            return;
        }
        // [snippet density-pairs]
        for (uint j = 0u; j < particleCount; j++)
            density += particleMass * kernel3(length(point - position[j].xyz));
        // [/snippet density-pairs]
    }
    if (nearBoundary(point)) {
        ivec3 centre = ivec3(floor(point / spacing));
        for (int z = -3; z <= 3; z++)
            for (int y = -3; y <= 3; y++)
                for (int x = -3; x <= 3; x++) {
                    ivec3 node = centre + ivec3(x, y, z);
                    vec3 ignoredVelocity;
                    if (boundaryNode(node, ignoredVelocity))
                        density += particleMass * kernel3(length(point - (vec3(node) + .5) * spacing));
                }
    }
    if (isnan(density) || isinf(density) || density <= 0.0) {
        atomicOr(flags, 16u);
        return;
    }
    // [snippet equation-of-state]
    float pressure = max(0.0, soundSpeed * soundSpeed * (density - rho0));
    field[i] = vec2(density, pressure);
    // [/snippet equation-of-state]
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
