#if LAB_CHECKPOINT >= 6
#version 430 core
layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer Offsets {
    uint offsets[];
};

layout(std430, binding = 1) writeonly buffer Cursors {
    uint cursors[];
};

uniform uint cellCount;
uniform uint particleCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < cellCount)
        cursors[i] = offsets[i];
    if (i == cellCount)
        offsets[i] = particleCount;
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
