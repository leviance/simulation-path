#if LAB_CHECKPOINT >= 6
#version 430 core
layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer Values {
    uint values[];
};

layout(std430, binding = 1) readonly buffer Prefix {
    uint blockPrefix[];
};

uniform uint entries;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < entries)
        values[i] += blockPrefix[i / 256u];
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
