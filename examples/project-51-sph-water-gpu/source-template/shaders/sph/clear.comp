#if LAB_CHECKPOINT >= 6
#version 430 core
layout(local_size_x = 128) in;

layout(std430, binding = 4) writeonly buffer Counts {
    uint counts[];
};

uniform uint cellCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < cellCount)
        counts[i] = 0u;
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
