#if LAB_CHECKPOINT >= 6
#version 430 core
layout(local_size_x = 128) in;
#include "shared/meta.glsl"
#include "shared/physics.glsl"

layout(std430, binding = 0) readonly buffer Positions {
    vec4 position[];
};

layout(std430, binding = 4) buffer Counts {
    uint counts[];
};

// [snippet cell-count]
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= particleCount || flags != 0u)
        return;
    vec3 point = position[i].xyz;
    if (!finite3(point) || any(lessThan(point, vec3(0))) || any(greaterThan(point, tankSize))) {
        atomicOr(flags, 1u);
        return;
    }
    // [snippet count]
    uint cell = cellIndex(point);
    atomicAdd(counts[cell], 1u);
    // [/snippet count]
}

// [/snippet cell-count]
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
