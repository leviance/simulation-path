#if LAB_CHECKPOINT >= 5
#version 430 core
layout(local_size_x = 128) in;
#include "shared/meta.glsl"

layout(std430, binding = 0) readonly buffer Velocities {
    vec4 velocity[];
};

layout(std430, binding = 1) readonly buffer Accelerations {
    vec4 acceleration[];
};

layout(std430, binding = 2) readonly buffer Fields {
    vec2 field[];
};

layout(std430, binding = 3) readonly buffer InputValues {
    vec4 inputValue[];
};

layout(std430, binding = 4) writeonly buffer OutputValues {
    vec4 outputValue[];
};

uniform uint entries;
uniform bool firstLevel;
uniform bool lastLevel;
uniform float h;
uniform float c;
shared vec4 partial[128];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint i = gl_GlobalInvocationID.x;
    vec4 value = vec4(0, 0, 3.402823e38, 0);
    if (i < entries) {
        if (firstLevel)
            value = vec4(length(velocity[i].xyz), length(acceleration[i].xyz), field[i].x, field[i].x);
        else
            value = inputValue[i];
    }
    // [snippet reduction]
    partial[lane] = value;
    barrier();
    for (uint stride = 64u; stride > 0u; stride /= 2u) {
        if (lane < stride) {
            vec4 other = partial[lane + stride];
            partial[lane] = vec4(max(partial[lane].xy, other.xy), min(partial[lane].z, other.z), max(partial[lane].w, other.w));
        }
        barrier();
    }
    if (lane == 0u) {
        outputValue[gl_WorkGroupID.x] = partial[0];
        if (lastLevel) {
            maximumSpeed = partial[0].x;
            maximumAcceleration = partial[0].y;
            minimumDensity = partial[0].z;
            maximumDensity = partial[0].w;
            dt = min(0.00075, min(0.25 * h / (c + maximumSpeed + 1.0), 0.25 * sqrt(h / max(maximumAcceleration, 1e-12))));
            if (isnan(dt) || isinf(dt) || dt < 1e-7)
                atomicOr(flags, 64u);
        }
    }
    // [/snippet reduction]
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
