#version 430 core
layout(local_size_x = 128) in;
#include "shared/meta.glsl"

void main() {
    if (gl_GlobalInvocationID.x != 0)
        return;
    updated = 0u;
    leakage = 0u;
    vec3 delta = bodyTarget.xyz - body.xyz;
    float distance = length(delta);
    bodyVelocity = vec4(delta * min(1.0, distance / .00075) / max(distance, 1e-12), 0.0);
    if (body.w <= 0.0)
        bodyVelocity = vec4(0.0);
}
