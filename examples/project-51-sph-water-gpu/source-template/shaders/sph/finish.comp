#if LAB_CHECKPOINT >= 5
#version 430 core
layout(local_size_x = 1) in;
#include "shared/meta.glsl"
uniform uint particleCount;

void main() {
    if (flags != 0u)
        return;
    if (updated != particleCount) {
        flags = 512u;
        return;
    }
    elapsed += dt;
    body.xyz += bodyVelocity.xyz * dt;
    ticks++;
}
#else
#version 430 core
layout(local_size_x = 128) in;

void main() {}
#endif
