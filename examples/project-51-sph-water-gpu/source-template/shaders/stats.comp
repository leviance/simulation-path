#version 430 core
#include "common.glsl"
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Velocities { vec4 velocities[]; };
layout(std430,binding=1) readonly buffer Density { vec4 density[]; };
layout(std430,binding=2) readonly buffer Acceleration { vec4 acceleration[]; };
layout(std430,binding=3) writeonly buffer Output { vec4 outputValues[]; };
shared vec4 partial[256];
void main() {
    // Pad inactive lanes, but every lane must reach every barrier.
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x;
    vec4 value=vec4(0.0);
    if(i<uCount) {
        value=vec4(length(velocities[i].xyz),length(acceleration[i].xyz),density[i].x,max(density[i].w,acceleration[i].w));
        if(bad(value.xyz)) value=vec4(0.0,0.0,0.0,1.0);
    }
    partial[lane]=value;
    barrier();
    for(uint stride=128u;stride>0u;stride/=2u) {
        if(lane<stride) partial[lane]=max(partial[lane],partial[lane+stride]);
        barrier();
    }
    if(lane==0u) outputValues[gl_WorkGroupID.x]=partial[0];
}
