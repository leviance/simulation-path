#version 430 core
#ifndef LAB_CHECKPOINT
#define LAB_CHECKPOINT 14
#endif

// Hierarchical integer scan adapted from Project 39; one bounded block is scanned here.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer InputBlock { uint inputValues[]; };
layout(std430, binding = 1) writeonly buffer OutputBlock { uint outputValues[]; };
layout(std430, binding = 2) writeonly buffer SumBlock { uint blockSums[]; };
uniform uint uCount;
shared uint scratch[256];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint id = gl_GlobalInvocationID.x;
    uint value = 0u;
    if (id < uCount) {
        value = inputValues[id];
    }
    scratch[lane] = value;
    barrier();
    for (uint stride = 1u; stride < 256u; stride *= 2u) {
        uint addition = 0u;
        if (lane >= stride) {
            addition = scratch[lane - stride];
        }
        barrier();
        scratch[lane] += addition;
        barrier();
    }
    if (id < uCount) {
        outputValues[id] = scratch[lane] - value;
    }
    if (lane == 255u) {
        blockSums[gl_WorkGroupID.x] = scratch[lane];
    }
}
