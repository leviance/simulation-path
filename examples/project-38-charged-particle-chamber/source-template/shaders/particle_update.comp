#version 430 core

#ifndef LAB_CHECKPOINT
#define LAB_CHECKPOINT 12
#endif
#if LAB_CHECKPOINT >= 7
layout(local_size_x = 256) in;
struct Particle { vec4 positionCharge; vec4 velocityMass; };
layout(std430, binding = 0) buffer State { Particle particles[]; };
uniform uint uCount;
uniform float uDt;
uniform float uChargeScale;
uniform vec3 uElectric;
uniform vec3 uMagnetic;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uCount) return;
    Particle p = particles[id];
    if (p.velocityMass.w <= 0.0 || any(isnan(p.positionCharge)) || any(isinf(p.positionCharge))
        || any(isnan(p.velocityMass)) || any(isinf(p.velocityMass))) return;

    // Same full-time convention and named intermediates as stepBoris in C++.
    vec3 oldVelocity = p.velocityMass.xyz;
    float halfImpulse = 0.5 * uDt * p.positionCharge.w * uChargeScale / p.velocityMass.w;
    vec3 vMinus = oldVelocity + uElectric * halfImpulse;
    vec3 t = uMagnetic * halfImpulse;
    vec3 s = 2.0 * t / (1.0 + dot(t, t));
    vec3 vPrime = vMinus + cross(vMinus, t);
    vec3 vPlus = vMinus + cross(vPrime, s);
    vec3 nextVelocity = vPlus + uElectric * halfImpulse;
    vec3 nextPosition = p.positionCharge.xyz + (oldVelocity + nextVelocity) * (0.5 * uDt);
    particles[id].positionCharge.xyz = nextPosition;
    particles[id].velocityMass.xyz = nextVelocity;
    // No wall, lifetime, clipping rule or respawn changes the physical trajectory.
}
#endif
