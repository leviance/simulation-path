#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer CellOffsets {
    uint cellOffsets[];
};

layout(std430, binding = 1) writeonly buffer CellCursors {
    uint cellCursors[];
};

uniform int uCellCount;

void main() {
#if LAB_CHECKPOINT >= 4
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= uint(uCellCount)) {
        return;
    }
    cellCursors[cell] = cellOffsets[cell];
#else
    if (uCellCount < 0) {
        cellCursors[0] = cellOffsets[0];
    }
#endif
}
