#version 430 core

// Mỗi invocation sở hữu một counter, vì vậy pass clear không cần atomic.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer CellCounts {
    uint cellCounts[];
};

uniform int uCellCount;

void main() {
#if LAB_CHECKPOINT >= 2
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= uint(uCellCount)) {
        return;
    }
    cellCounts[cell] = 0u;
#else
    // Starter giữ shader hợp lệ nhưng chưa thay đổi dữ liệu.
    if (uCellCount < 0) {
        cellCounts[0] = 0u;
    }
#endif
}
