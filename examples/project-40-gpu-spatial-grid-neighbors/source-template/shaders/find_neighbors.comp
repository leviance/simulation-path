#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 1) readonly buffer CellCounts {
    uint cellCounts[];
};

layout(std430, binding = 2) readonly buffer CellOffsets {
    uint cellOffsets[];
};

layout(std430, binding = 3) readonly buffer SortedIndices {
    uint sortedIndices[];
};

struct NeighborSummary {
    uint neighborCount;
    uint nearestIndex;
    float nearestDistanceSquared;
    uint visitedCandidates;
};

layout(std430, binding = 4) writeonly buffer NeighborSummaries {
    NeighborSummary neighborSummaries[];
};

uniform int uParticleCount;
uniform int uColumns;
uniform int uRows;
uniform float uCellSize;
uniform float uWorldWidth;
uniform float uWorldHeight;
uniform float uRadius;

ivec2 cellCoordinate(vec2 position) {
    vec2 maximumInside = vec2(uWorldWidth, uWorldHeight) - vec2(0.0001);
    vec2 inside = clamp(position, vec2(0.0), maximumInside);
    ivec2 coordinate = ivec2(floor(inside / uCellSize));
    coordinate.x = clamp(coordinate.x, 0, uColumns - 1);
    coordinate.y = clamp(coordinate.y, 0, uRows - 1);
    return coordinate;
}

bool isBetter(float distanceSquared, uint index, float bestDistanceSquared, uint bestIndex) {
    const float tieEpsilon = 0.000001;
    if (distanceSquared + tieEpsilon < bestDistanceSquared) {
        return true;
    }
    return abs(distanceSquared - bestDistanceSquared) <= tieEpsilon && index < bestIndex;
}

void main() {
#if LAB_CHECKPOINT >= 5
    uint particle = gl_GlobalInvocationID.x;
    if (particle >= uint(uParticleCount)) {
        return;
    }

    vec2 query = positions[particle];
    ivec2 minimumCell = cellCoordinate(query - vec2(uRadius));
    ivec2 maximumCell = cellCoordinate(query + vec2(uRadius));
    NeighborSummary summary = NeighborSummary(0u, 0xffffffffu, 3.402823466e+38, 0u);
    float radiusSquared = uRadius * uRadius;

    for (int row = minimumCell.y; row <= maximumCell.y; ++row) {
        for (int column = minimumCell.x; column <= maximumCell.x; ++column) {
            uint cell = uint(row * uColumns + column);
            uint begin = cellOffsets[cell];
            uint end = begin + cellCounts[cell];
            for (uint slot = begin; slot < end; ++slot) {
                uint candidate = sortedIndices[slot];
                if (candidate == particle) {
                    continue;
                }
                ++summary.visitedCandidates;
#if LAB_CHECKPOINT >= 6
                vec2 delta = positions[candidate] - query;
                float candidateDistanceSquared = dot(delta, delta);
                if (candidateDistanceSquared > radiusSquared) {
                    continue;
                }
                ++summary.neighborCount;
                if (isBetter(candidateDistanceSquared, candidate, summary.nearestDistanceSquared, summary.nearestIndex)) {
                    summary.nearestDistanceSquared = candidateDistanceSquared;
                    summary.nearestIndex = candidate;
                }
#endif
            }
        }
    }
    neighborSummaries[particle] = summary;
#else
    if (uParticleCount + uColumns + uRows < 0 || uCellSize + uWorldWidth + uWorldHeight + uRadius < 0.0) {
        neighborSummaries[0] = NeighborSummary(cellCounts[0], cellOffsets[0], positions[0].x, sortedIndices[0]);
    }
#endif
}
