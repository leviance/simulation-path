#version 430 core

#if LAB_CHECKPOINT >= 4
layout(local_size_x = 256) in;

struct Particle {
    vec4 positionAge;
    vec4 velocityLife;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform int uParticleCount;
uniform float uDt;
uniform float uGravity;
uniform uint uSpawnEpoch;

const uint kSeed = 0x38c0ffeeu;
const float kFloorY = -2.0;

uint mixBits(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float random01(uint index, uint channel, uint seed) {
    uint bits = mixBits(index ^ (channel * 0x9e3779b9u) ^ seed);
    return float(bits & 0x00ffffffu) / 16777215.0;
}

Particle makeSpawnParticle(uint index, uint spawnEpoch) {
    uint epochSeed = kSeed ^ mixBits(spawnEpoch + 0x632be59bu);
    float emitterX = -0.32 + random01(index, 0u, epochSeed) * 0.64;
    float velocityX = -1.45 + random01(index, 1u, epochSeed) * 2.90;
    float velocityY = 5.7 + random01(index, 2u, epochSeed) * 4.6;
    float lifetime = 1.8 + random01(index, 3u, epochSeed) * 2.8;

    Particle particle;
    particle.positionAge = vec4(emitterX, 0.0, 0.0, 0.0);
    particle.velocityLife = vec4(velocityX, velocityY, 0.0, lifetime);
    return particle;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(uParticleCount)) {
        return;
    }

    Particle particle = particles[index];
    particle.velocityLife.y += uGravity * uDt;
    particle.positionAge.xyz += particle.velocityLife.xyz * uDt;
    particle.positionAge.w += uDt;

    bool lifetimeEnded = particle.positionAge.w >= particle.velocityLife.w;
    bool fellBelowFloor = particle.positionAge.y < kFloorY;
    if (lifetimeEnded || fellBelowFloor) {
        particle = makeSpawnParticle(index, uSpawnEpoch);
    }

    particles[index] = particle;
}
#endif
