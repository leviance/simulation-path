#version 430 core

#if LAB_CHECKPOINT >= 3
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputA {
    vec4 inputA[];
};

layout(std430, binding = 1) readonly buffer InputB {
    vec4 inputB[];
};

layout(std430, binding = 2) writeonly buffer Output {
    vec4 outputData[];
};
#endif

#if LAB_CHECKPOINT >= 5
uniform int uElementCount;
#endif

#if LAB_CHECKPOINT >= 9
uniform int uOperation;
uniform float uScalar;
#endif

void main() {
#if LAB_CHECKPOINT >= 4
    uint index = gl_GlobalInvocationID.x;
#if LAB_CHECKPOINT >= 5
    if (index >= uint(uElementCount)) {
        return;
    }
#endif
#if LAB_CHECKPOINT >= 9
    if (uOperation == 1) {
        outputData[index] = inputA[index] * uScalar + inputB[index];
    } else if (uOperation == 2) {
        outputData[index] = inputA[index] - inputB[index];
    } else {
        outputData[index] = inputA[index] + inputB[index];
    }
#else
    outputData[index] = inputA[index] + inputB[index];
#endif
#endif
}
