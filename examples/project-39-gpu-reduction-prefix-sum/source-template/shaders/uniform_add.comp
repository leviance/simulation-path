#version 430 core

layout(local_size_x = 256) in;

#if LAB_CHECKPOINT >= 7
layout(std430, binding = 0) buffer ScanOutputBuffer {
    float scanOutput[];
};

layout(std430, binding = 1) readonly buffer BlockOffsetsBuffer {
    float blockOffsets[];
};

uniform int uElementCount;

// Offset của block b là tổng exclusive của mọi block đứng trước b.
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(uElementCount)) {
        return;
    }

    uint blockIndex = index / 512u;
    scanOutput[index] += blockOffsets[blockIndex];
}
#else
// Bài 7 sẽ cộng prefix của các block đứng trước vào từng local prefix.
void main() {
}
#endif
