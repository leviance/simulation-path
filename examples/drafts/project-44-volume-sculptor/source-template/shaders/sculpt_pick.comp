#version 430 core
layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer ScalarField { float field[]; };
layout(std430, binding = 7) buffer PickResult {
    vec4 pointValue;
    vec4 normalHit;
    vec4 gridCoordinate;
    uvec4 state;
};
uniform int gridN;
uniform vec3 gridOrigin;
uniform float gridSpacing;
uniform float isovalue;
uniform vec3 rayOrigin;
uniform vec3 rayDirection;
uniform uint fieldRevision;

float at(ivec3 c) {
    return field[(c.z * gridN + c.y) * gridN + c.x];
}

float sampleField(vec3 point) {
    vec3 coordinate = clamp((point - gridOrigin) / gridSpacing, vec3(0), vec3(gridN - 1));
    ivec3 c = min(ivec3(floor(coordinate)), ivec3(gridN - 2));
    vec3 t = coordinate - vec3(c);
    float y0 = mix(at(c), at(c + ivec3(1,0,0)), t.x);
    float y1 = mix(at(c + ivec3(0,1,0)), at(c + ivec3(1,1,0)), t.x);
    float nextY0 = mix(at(c + ivec3(0,0,1)), at(c + ivec3(1,0,1)), t.x);
    float nextY1 = mix(at(c + ivec3(0,1,1)), at(c + ivec3(1,1,1)), t.x);
    return mix(mix(y0,y1,t.y), mix(nextY0,nextY1,t.y), t.z);
}

bool boxInterval(vec3 maximum, out float entry, out float exit) {
    entry = 0.0;
    exit = 32.0;
    for (int axis = 0; axis < 3; ++axis) {
        if (abs(rayDirection[axis]) < 1e-8) {
            if (rayOrigin[axis] < gridOrigin[axis] || rayOrigin[axis] > maximum[axis])
                return false;
        } else {
            float a = (gridOrigin[axis] - rayOrigin[axis]) / rayDirection[axis];
            float b = (maximum[axis] - rayOrigin[axis]) / rayDirection[axis];
            entry = max(entry, min(a,b));
            exit = min(exit, max(a,b));
        }
    }
    return exit >= entry;
}

void reportHit(float distance, uint steps) {
    vec3 point = rayOrigin + rayDirection * distance;
    vec3 maximum = gridOrigin + vec3(gridSpacing * float(gridN - 1));
    float h = 0.5 * gridSpacing;
    vec3 low = clamp(point - vec3(h), gridOrigin, maximum);
    vec3 high = clamp(point + vec3(h), gridOrigin, maximum);
    vec3 gradient = vec3(
        (sampleField(vec3(high.x,point.y,point.z)) - sampleField(vec3(low.x,point.y,point.z))) / (high.x-low.x),
        (sampleField(vec3(point.x,high.y,point.z)) - sampleField(vec3(point.x,low.y,point.z))) / (high.y-low.y),
        (sampleField(vec3(point.x,point.y,high.z)) - sampleField(vec3(point.x,point.y,low.z))) / (high.z-low.z));
    vec3 normal = -rayDirection;
    if (length(gradient) > 1e-10)
        normal = normalize(gradient);
    pointValue = vec4(point, sampleField(point));
    normalHit = vec4(normal,1);
    gridCoordinate = vec4((point - gridOrigin) / gridSpacing, distance);
    state = uvec4(1, fieldRevision, steps, 0);
}

void main() {
    pointValue = vec4(0);
    normalHit = vec4(0);
    gridCoordinate = vec4(0);
    state = uvec4(0, fieldRevision, 0, 0);
    float entry, exit;
    vec3 maximum = gridOrigin + vec3(gridSpacing * float(gridN - 1));
    if (!boxInterval(maximum,entry,exit))
        return;
    float previousT = entry;
    float previous = sampleField(rayOrigin + rayDirection * entry) - isovalue;
    // A generic edited scalar field is NOT an SDF: use a fixed spatial step, not value-sized steps.
    for (uint step = 0u; step < 2048u; ++step) {
        if (abs(previous) < 1e-6) {
            reportHit(previousT,step+1u);
            return;
        }
        float nextT = min(previousT + gridSpacing * 0.25, exit);
        float next = sampleField(rayOrigin + rayDirection * nextT) - isovalue;
        if ((previous < 0.0) != (next < 0.0)) {
            float low = previousT, high = nextT;
            for (int iteration = 0; iteration < 12; ++iteration) {
                float middle = 0.5 * (low+high);
                float value = sampleField(rayOrigin + rayDirection * middle) - isovalue;
                if ((value < 0.0) == (previous < 0.0))
                    low = middle;
                else
                    high = middle;
            }
            reportHit(0.5*(low+high),step+1u);
            return;
        }
        if (nextT >= exit) {
            state.z = step+1u;
            return;
        }
        previousT = nextT;
        previous = next;
    }
    state.w = 1u;
}
