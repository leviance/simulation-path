#version 430 core
#if LAB_CHECKPOINT >= 7
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer ScalarField { float field[]; };
layout(std430, binding = 1) buffer Counts { uint counts[]; };
layout(std430, binding = 2) readonly buffer Offsets { uint offsets[]; };
struct ChunkStat { uvec4 geometry; uvec4 outputState; };
layout(std430, binding = 4) buffer Stats { ChunkStat stats[]; };
#if LAB_CHECKPOINT >= 8
// snippet:sculpt-gpu-mesh-storage
struct Vertex { vec4 position; vec4 normal; };
layout(std430, binding = 5) buffer Mesh { Vertex vertices[]; };
// end-snippet:sculpt-gpu-mesh-storage
#endif
uniform int gridN;
uniform vec3 gridOrigin;
uniform float gridSpacing;
uniform float isovalue;
uniform uint chunk;
uniform uint generation;
uniform int phase;
#if LAB_CHECKPOINT >= 8
uniform uint vertexCapacity;
#endif

const ivec3 corners[8] = ivec3[8](
    ivec3(0,0,0), ivec3(1,0,0), ivec3(1,1,0), ivec3(0,1,0),
    ivec3(0,0,1), ivec3(1,0,1), ivec3(1,1,1), ivec3(0,1,1));
const ivec4 tetrahedra[6] = ivec4[6](
    ivec4(0,1,2,6), ivec4(0,2,3,6), ivec4(0,3,7,6),
    ivec4(0,7,4,6), ivec4(0,4,5,6), ivec4(0,5,1,6));

struct Corner { uint id; vec3 point; float value; };
uint cellVertices;
#if LAB_CHECKPOINT >= 8
uint writeBase;
#endif

bool bad(vec3 v) {
    return any(isnan(v)) || any(isinf(v));
}

Corner loadCorner(ivec3 coordinate) {
    uint id = uint((coordinate.z * gridN + coordinate.y) * gridN + coordinate.x);
    precise vec3 point = gridOrigin + vec3(coordinate) * gridSpacing;
    return Corner(id, point, field[id]);
}

// snippet:sculpt-gpu-edge-interpolation
vec3 edgePoint(Corner a, Corner b) {
    if (b.id < a.id) {
        Corner temporary = a;
        a = b;
        b = temporary;
    }
    precise float t = clamp((isovalue - a.value) / (b.value - a.value), 0.0, 1.0);
    precise vec3 point = a.point + (b.point - a.point) * t;
    return point;
}
// end-snippet:sculpt-gpu-edge-interpolation

// snippet:sculpt-gpu-count-triangle
void triangle(vec3 a, vec3 b, vec3 c, vec3 towardOutside) {
    // Work in cell units; a nonzero small triangle must not leave a hole.
    vec3 area = cross((b - a) / gridSpacing, (c - a) / gridSpacing);
    if (bad(a) || bad(b) || bad(c) || bad(area)) {
        atomicAdd(stats[chunk].geometry.w, 1u);
        return;
    }
    float areaScale = max(max(abs(area.x), abs(area.y)), abs(area.z));
    if (areaScale == 0.0) {
        if (phase == 0)
            atomicAdd(stats[chunk].geometry.z, 1u);
        return;
    }
    // The largest component becomes one before dot/normalize can underflow.
    area /= areaScale;
    if (dot(area, towardOutside) < 0.0) {
        vec3 temporary = b;
        b = c;
        c = temporary;
        area = -area;
    }
#if LAB_CHECKPOINT >= 8
    // snippet:sculpt-gpu-emit-triangle
    if (phase == 1) {
        uint begin = writeBase + cellVertices;
        if (begin > vertexCapacity || vertexCapacity - begin < 3u) {
            atomicAdd(stats[chunk].outputState.w, 1u);
            cellVertices += 3u;
            return;
        }
        vec3 normal = normalize(area);
        vertices[begin] = Vertex(vec4(a,1), vec4(normal,0));
        vertices[begin + 1u] = Vertex(vec4(b,1), vec4(normal,0));
        vertices[begin + 2u] = Vertex(vec4(c,1), vec4(normal,0));
        atomicAdd(stats[chunk].outputState.x, 3u);
    }
    // end-snippet:sculpt-gpu-emit-triangle
#endif
    cellVertices += 3u;
}
// end-snippet:sculpt-gpu-count-triangle

// snippet:sculpt-gpu-tetra-cases
void tetra(Corner v[4]) {
    int inside[4], outside[4];
    int ni = 0, no = 0;
    vec3 inSum = vec3(0), outSum = vec3(0);
    for (int index = 0; index < 4; ++index) {
        if (isnan(v[index].value) || isinf(v[index].value)) {
            atomicAdd(stats[chunk].geometry.w, 1u);
            return;
        }
        if (v[index].value < isovalue) {
            inside[ni++] = index;
            inSum += v[index].point;
        } else {
            outside[no++] = index;
            outSum += v[index].point;
        }
    }
    if (ni == 0 || ni == 4)
        return;
    vec3 direction = outSum / float(no) - inSum / float(ni);
    if (ni == 1)
        triangle(edgePoint(v[inside[0]], v[outside[0]]), edgePoint(v[inside[0]], v[outside[1]]), edgePoint(v[inside[0]], v[outside[2]]), direction);
    else if (ni == 3)
        triangle(edgePoint(v[outside[0]], v[inside[0]]), edgePoint(v[outside[0]], v[inside[1]]), edgePoint(v[outside[0]], v[inside[2]]), direction);
    else {
        vec3 ac = edgePoint(v[inside[0]], v[outside[0]]);
        vec3 ad = edgePoint(v[inside[0]], v[outside[1]]);
        vec3 bc = edgePoint(v[inside[1]], v[outside[0]]);
        vec3 bd = edgePoint(v[inside[1]], v[outside[1]]);
        triangle(ac, ad, bd, direction);
        triangle(ac, bd, bc, direction);
    }
}
// end-snippet:sculpt-gpu-tetra-cases

// snippet:sculpt-gpu-count-kernel
void main() {
    uint local = gl_GlobalInvocationID.x;
    if (local >= 4096u)
        return;
    uint side = uint((gridN - 2) / 16 + 1);
    uvec3 chunkCoordinate = uvec3(chunk % side, (chunk / side) % side, chunk / (side * side));
    ivec3 coordinate = ivec3(chunkCoordinate * 16u + uvec3(local % 16u, (local / 16u) % 16u, local / 256u));
    uint cell = chunk * 4096u + local;
    if (any(greaterThanEqual(coordinate, ivec3(gridN - 1)))) {
        if (phase == 0)
            counts[cell] = 0u;
        return;
    }
    if (stats[chunk].outputState.z != generation) {
        atomicAdd(stats[chunk].outputState.w, 1u);
        return;
    }
    Corner cube[8];
    for (int index = 0; index < 8; ++index)
        cube[index] = loadCorner(coordinate + corners[index]);
    cellVertices = 0u;
#if LAB_CHECKPOINT >= 8
    // snippet:sculpt-gpu-emit-offset
    writeBase = 0u;
    if (phase == 1)
        writeBase = offsets[cell];
    // end-snippet:sculpt-gpu-emit-offset
#endif
    for (int index = 0; index < 6; ++index) {
        ivec4 ids = tetrahedra[index];
        Corner v[4] = Corner[4](cube[ids.x], cube[ids.y], cube[ids.z], cube[ids.w]);
        tetra(v);
    }
    if (phase == 0) {
        counts[cell] = cellVertices;
        if (cellVertices > 0u)
            atomicAdd(stats[chunk].geometry.y, 1u);
    } else if (cellVertices != counts[cell])
        atomicAdd(stats[chunk].outputState.w, 1u);
}
// end-snippet:sculpt-gpu-count-kernel
#else
layout(local_size_x = 256) in;
void main() {}
#endif
