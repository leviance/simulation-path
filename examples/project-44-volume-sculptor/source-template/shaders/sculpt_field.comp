#version 430 core
#if LAB_CHECKPOINT >= 6
// snippet:sculpt-gpu-field-layout
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer ScalarField { float field[]; };
#if LAB_CHECKPOINT >= 10
layout(std430, binding = 1) readonly buffer SourceField { float sourceField[]; };
#endif
struct Stamp { vec4 centerRadius; vec4 strengthMode; };
layout(std430, binding = 6) readonly buffer Stamps { Stamp stamps[]; };
layout(std430, binding = 7) buffer EditSummary { uvec4 editSummary; };
// end-snippet:sculpt-gpu-field-layout
uniform int gridN;
uniform vec3 gridOrigin;
uniform float gridSpacing;
uniform int operation;
uniform int shape;
uniform uint firstSample;
uniform uint sampleBatch;
uniform vec3 regionLow;
uniform vec3 regionSize;
uniform int stampCount;
#if LAB_CHECKPOINT >= 10
uniform int sourceN;
uniform vec3 sourceOrigin;
uniform float sourceSpacing;

float sourceAt(ivec3 c) {
    return sourceField[(c.z * sourceN + c.y) * sourceN + c.x];
}

// snippet:sculpt-resample-source-field
float resampledValue(vec3 point) {
    vec3 coordinate = clamp((point - sourceOrigin) / sourceSpacing, vec3(0), vec3(sourceN - 1));
    ivec3 c = min(ivec3(floor(coordinate)), ivec3(sourceN - 2));
    vec3 t = coordinate - vec3(c);
    float y0 = mix(sourceAt(c), sourceAt(c + ivec3(1,0,0)), t.x);
    float y1 = mix(sourceAt(c + ivec3(0,1,0)), sourceAt(c + ivec3(1,1,0)), t.x);
    float nextY0 = mix(sourceAt(c + ivec3(0,0,1)), sourceAt(c + ivec3(1,0,1)), t.x);
    float nextY1 = mix(sourceAt(c + ivec3(0,1,1)), sourceAt(c + ivec3(1,1,1)), t.x);
    return mix(mix(y0, y1, t.y), mix(nextY0, nextY1, t.y), t.z);
}
// end-snippet:sculpt-resample-source-field
#endif

// snippet:sculpt-gpu-initial-value
float initialValue(vec3 p) {
    if (shape == 0)
        return length(p) - 0.82;
    if (shape == 1)
        return min(length(p - vec3(-0.55, 0, 0)) - 0.42, length(p - vec3(0.55, 0, 0)) - 0.42);
    if (shape == 2)
        return length(vec2(length(p.xz) - 0.68, p.y)) - 0.22;
    // Only the finite validation path requests this independent analytic plane.
    return dot(p, normalize(vec3(1, 2, -1))) - 0.13;
}
// end-snippet:sculpt-gpu-initial-value

// snippet:sculpt-gpu-field-kernel
void main() {
    uint lane = gl_GlobalInvocationID.x;
    if (lane >= sampleBatch)
        return;
    uint n = uint(gridN);
    bool initialize = operation == 0;
#if LAB_CHECKPOINT >= 10
    initialize = initialize || operation == 2;
#endif
    if (initialize) {
        uint id = firstSample + lane;
        if (id >= n * n * n)
            return;
        uvec3 coordinate = uvec3(id % n, (id / n) % n, id / (n * n));
        vec3 point = gridOrigin + vec3(coordinate) * gridSpacing;
#if LAB_CHECKPOINT >= 10
        if (operation == 2)
            field[id] = resampledValue(point);
        else
#endif
            field[id] = initialValue(point);
        return;
    }
    uvec3 extent = uvec3(regionSize);
    uint voxel = firstSample + lane;
    if (voxel >= extent.x * extent.y * extent.z)
        return;
    ivec3 coordinate = ivec3(regionLow) + ivec3(voxel % extent.x, (voxel / extent.x) % extent.y, voxel / (extent.x * extent.y));
    if (any(lessThanEqual(coordinate, ivec3(0))) || any(greaterThanEqual(coordinate, ivec3(gridN - 1))))
        return;
    uint id = uint((coordinate.z * gridN + coordinate.y) * gridN + coordinate.x);
    vec3 point = gridOrigin + vec3(coordinate) * gridSpacing;
    atomicAdd(editSummary.z, 1u);
    float before = field[id];
    float value = before;
    for (int stamp = 0; stamp < 8; ++stamp) {
        if (stamp >= stampCount)
            break;
        float ratio = length(point - stamps[stamp].centerRadius.xyz) / stamps[stamp].centerRadius.w;
        float remaining = max(0.0, 1.0 - ratio * ratio);
        float delta = stamps[stamp].strengthMode.x * remaining * remaining;
        if (delta == 0.0)
            continue;
        if (stamps[stamp].strengthMode.y < 0.5)
            delta = -delta;
        value = clamp(value + delta, -4.0, 4.0);
    }
    if (isnan(value) || isinf(value)) {
        atomicAdd(editSummary.y, 1u);
        return;
    }
    // Merely visiting a bounding box is not an edit: preserve bits/history for no-op stamps.
    if (value != before) {
        field[id] = value;
        atomicAdd(editSummary.x, 1u);
    }
}
// end-snippet:sculpt-gpu-field-kernel
#else
// Earlier CPU checkpoints do not dispatch this shader.
layout(local_size_x = 256) in;
void main() {}
#endif
